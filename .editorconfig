# VS Code Settings

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
indent_size = 2
indent_style = space
max_line_length = 100

[*.scss]
indent_size = 2
indent_style = space
max_line_length = 100

[*.html]
indent_size = 2
indent_style = space
max_line_length = 100

[*.md]
max_line_length = 100
